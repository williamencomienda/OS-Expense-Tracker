<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GCAT.ViewModels"
             xmlns:controls="using:GCAT.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="GCAT.Views.Controls.SetBudgetPopup"
             x:DataType="vm:SetBudgetViewModel"
             Width="460">

  <Grid>

    <!-- Main "Set budget" form -->
    <Border Classes="PopupCard" IsVisible="{Binding !IsMonthPickerOpen}">
      <StackPanel Spacing="18">

        <!-- drag handle -->
        <Border Width="60" Height="5" CornerRadius="3" Background="#4A2C3A" HorizontalAlignment="Center" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Set budget" FontSize="20" FontWeight="Bold" Foreground="White" />
          <Button Grid.Column="1" Classes="IconButton" Command="{Binding CancelCommand}">
            <TextBlock Text="&#10005;" FontSize="16" Foreground="White" />
          </Button>
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock Text="DATE" Classes="PopupSectionLabel" />
          <Button Classes="PopupField" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Command="{Binding OpenMonthPickerCommand}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding SelectedMonthYearLabel}" Foreground="White" />
              <TextBlock Grid.Column="1" Text="&#9662;" Foreground="White" />
            </Grid>
          </Button>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding CategoryInputs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BudgetInputRow">
              <StackPanel Spacing="6" Margin="0,0,0,14">
                <TextBlock Text="{Binding CategoryLabel}" Classes="PopupSectionLabel" />
                <TextBox Classes="PopupField" Watermark="Enter amount" Text="{Binding AmountText}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="*,16,*" Margin="0,8,0,0">
          <Button Grid.Column="0" Classes="PopupCancel" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Classes="PopupSubmit" Content="Set budget" Command="{Binding SubmitCommand}" />
        </Grid>

      </StackPanel>
    </Border>

    <!-- Month picker, swapped in over the same card area while open -->
    <Border Classes="PopupCard" IsVisible="{Binding IsMonthPickerOpen}">
      <controls:MonthPickerPopup MonthPicker="{Binding ActiveMonthPicker}"
                                  CloseCommand="{Binding CloseMonthPickerCommand}" />
    </Border>

  </Grid>
</UserControl>

